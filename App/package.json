{
  "name": "genosyn-app",
  "version": "0.1.0",
  "private": true,
  "description": "Genosyn App \u2014 run companies autonomously with AI employees",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore='**/vite.config.*' --ignore='client/**' --ignore='dist/**' --ignore='data/**' server/index.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "rm -rf dist/server && tsc -p tsconfig.server.json && mkdir -p dist/server/mcp-browser/viewer dist/server/browser-bridge && cp server/mcp-browser/*.mjs dist/server/mcp-browser/ && cp server/browser-bridge/*.mjs dist/server/browser-bridge/ && cp server/mcp-browser/viewer/index.html server/mcp-browser/viewer/viewer.js dist/server/mcp-browser/viewer/ && cp -R server/assets dist/server/",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.clienttest.json --noEmit",
    "test": "tsx --test --import ./server/test/httpSetup.ts \"server/**/*.test.ts\" \"client/**/*.test.ts\"",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d ormconfig.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d ormconfig.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ormconfig.ts",
    "migration:show": "npm run typeorm -- migration:show -d ormconfig.ts",
    "license:keygen": "tsx server/scripts/licenseKeygen.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@clickhouse/client": "^1.18.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^1.0.5",
    "@openai/codex": "0.146.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/archiver": "^7.0.0",
    "@types/unzipper": "^0.10.11",
    "@types/web-push": "^3.6.4",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.1.2",
    "cookie": "^1.1.1",
    "cookie-session": "^2.1.0",
    "cron-parser": "^4.9.0",
    "cronstrue": "^2.50.0",
    "dompurify": "^3.4.12",
    "epubjs": "^0.4.2",
    "express": "^4.22.2",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "keygrip": "^1.1.0",
    "lucide-react": "^0.445.0",
    "marked": "^14.1.2",
    "multer": "^2.2.0",
    "mysql2": "^3.22.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.13.0",
    "playwright-core": "^1.59.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "reflect-metadata": "^0.2.2",
    "slugify": "^1.6.6",
    "ssh2-sftp-client": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "undici": "^7.28.0",
    "unzipper": "^0.12.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^0.6.0",
    "@types/cookie-session": "^2.0.49",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/keygrip": "^1.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.5.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "brace-expansion": "^5.0.8",
    "epubjs": {
      "xmldom": "npm:@xmldom/xmldom@^0.9.10"
